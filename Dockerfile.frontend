FROM eclipse-temurin:17-jdk

WORKDIR /app

COPY backend/src/main/java/com/fase1/calculadora/FrontendServer.java /app/src/com/fase1/calculadora/FrontendServer.java
COPY frontend/ /app/frontend/

RUN mkdir -p /app/out \
    && javac --add-modules jdk.httpserver \
    -d /app/out \
    /app/src/com/fase1/calculadora/FrontendServer.java

ENV PUBLIC_BACKEND_PORT=8082

EXPOSE 8081

CMD ["sh", "-c", "java --add-modules jdk.httpserver -cp /app/out com.fase1.calculadora.FrontendServer http://backend:8082 8081 auto:${PUBLIC_BACKEND_PORT}"]
